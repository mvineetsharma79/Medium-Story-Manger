# ============================================
# Story Manager - Environment Configuration
# ============================================

# Application Settings
# -------------------
# APP_NAME: Display name for the application
APP_NAME="Story Manager"

# DEBUG: Enable debug mode (true/false)
# - true: Enables auto-reload, detailed error pages, development features
# - false: Production mode with optimized performance
DEBUG=true

# SECRET_KEY: Used for session signing and security (change in production!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="change-this-to-a-secure-random-string-in-production"

# Stories Directory
# -----------------
# STORIES_ROOT: Absolute or relative path to your stories directory
# Examples:
#   - Absolute: /Users/username/Documents/medium-stories
#   - Relative: ./stories (relative to project root)
STORIES_ROOT="./stories"

# Publishing Calendar Settings
# ----------------------------
# DEFAULT_SERIES_SPACING_DAYS: Default days between parts of same series (5-14)
DEFAULT_SERIES_SPACING_DAYS=7

# DEFAULT_STORIES_PER_WEEK: Maximum stories to schedule per week (1-7)
DEFAULT_STORIES_PER_WEEK=3

# PREFERRED_PUBLISH_DAYS: Days of week to publish stories (JSON array format)
# Options: Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday
PREFERRED_PUBLISH_DAYS='["Monday", "Tuesday", "Wednesday", "Thursday"]'

# START_DATE: First date for calendar generation (YYYY-MM-DD format)
# Leave empty to use current date
START_DATE=""

# API Settings
# ------------
# API_RATE_LIMIT: Maximum requests per minute per IP (optional)
API_RATE_LIMIT=60

# CORS_ORIGINS: Allowed origins for CORS (JSON array format)
# For development: ["http://localhost:8000", "http://127.0.0.1:8000"]
# For production: Add your domain
CORS_ORIGINS='["http://localhost:8000", "http://127.0.0.1:8000"]'

# Logging
# -------
# LOG_LEVEL: Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# LOG_FILE: Path to log file (optional, leave empty for console only)
LOG_FILE=""

# Security
# --------
# SESSION_TIMEOUT: Session timeout in minutes
SESSION_TIMEOUT=1440

# MAX_UPLOAD_SIZE: Maximum file upload size in MB
MAX_UPLOAD_SIZE=10

# Docker Specific Settings
# ------------------------
# These are used when running with Docker
# DOCKER_HOST_IP: Host IP for Docker container (auto-detected if empty)
DOCKER_HOST_IP=""

# VOLUME_MOUNT_PATH: Path where stories volume is mounted in Docker
VOLUME_MOUNT_PATH="/app/stories"

# Data Directory
# --------------
# Where to store stories.json and calendar files
DATA_DIR="./data"